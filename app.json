{
  "expo": {
    "name": "AfterCredits",
    "slug": "after-credits",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/after-credits-icon.png",
    "scheme": "aftercredits",
    "userInterfaceStyle": "automatic",
    "ios": {
      "infoPlist": {
        "NSPhotoLibraryUsageDescription": "Allow AfterCredits to access your photos so you can set a profile picture."
      },
      "bundleIdentifier": "com.nishka150.aftercredits"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#441214",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.nishka150.aftercredits"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#441214",
          "image": "./assets/images/after-credits-icon.png",
          "imageWidth": 76
        }
      ],
      "expo-font",
      "expo-image",
      "expo-web-browser"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "131a4179-e8e7-4d79-86a7-b68bc74bba03"
      }
    },
    "owner": "nishka150s-team"
  }
}
